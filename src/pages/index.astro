---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import BaseLayout from "../layouts/BaseLayout.astro";
import ClaimStamp from "../components/ClaimStamp.astro";
import SemesterWeekGrid from "../components/SemesterWeekGrid.astro";
import { courseMeta } from "../course-config";
import { formatCourseDate } from "../lib/dates";
import { siteConfig } from "../site-config";

const sessions = (await getPublishedCollection("sessions")).sort((a, b) => a.data.week - b.data.week);
const assessments = (await getPublishedCollection("assessments")).sort((a, b) => a.data.week - b.data.week);
const people = await getPublishedCollection("people");

const person = (slug: string) => people.find((p) => p.id === slug);
const firstWeek = sessions[0];

// `format`/`term`/`termGloss`/`streams` come through courseNodeSchema's
// `.loose()` passthrough (src/content.config.ts), so Astro/Zod types them as
// `unknown` at the call site — cast here rather than widen the shared schema
// from a page outside this task's write scope (same approach StreamBands.astro
// already takes for `streams`).
interface SessionExtra {
  format?: string;
  term?: string;
  termGloss?: string;
  streams?: { name: string; slug: string; focus?: string }[];
}
const extra = (s: (typeof sessions)[number]) => s.data as unknown as SessionExtra;

const totalWeight = assessments.reduce((sum, a) => sum + a.data.weight, 0);

// Streams are a curricular fact, not content nodes: the names and taglines are
// fixed by the course spec, but the convenor's name and the week-1 focus line
// come from real content so the two can never disagree.
const streams = [
  {
    name: "Technical Practice",
    slug: "technical",
    tagline:
      "For the fields where the performance is competence, and someone will eventually ask you to open a terminal in front of them.",
    convenor: "anselm-pike",
  },
  {
    name: "Creative and Communications Practice",
    slug: "creative",
    tagline:
      "For the fields where the performance is taste, and the portfolio is both the evidence and the alibi.",
    convenor: "nadia-ferrante",
  },
  {
    name: "Commercial and Public Practice",
    slug: "commercial",
    tagline:
      "For the fields where the performance is judgement, and nobody will ever ask to see the spreadsheet.",
    convenor: "sunil-raman",
  },
].map((stream, i) => ({
  ...stream,
  n: i + 1,
  focus: firstWeek && extra(firstWeek).streams?.find((s) => s.slug === stream.slug)?.focus,
}));

// Glossary teaser: the first three weeks' own term-of-the-week, not rewritten.
const glossPreview = sessions.slice(0, 3);

const ladderColors = ["var(--claim-fill)", "var(--accent-3-fill)", "var(--ink-line)", "var(--evidence-fill)"];
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  favicon={siteConfig.favicon}
>
  <section class="band band--ink hero">
    <div>
      <p class="eyebrow hero__eyebrow">
        {courseMeta.session} {courseMeta.year} · Level {courseMeta.level} · No field prerequisite
      </p>
      <h1 class="h-display">{courseMeta.title}</h1>
      <p class="hero__sub">Twelve weeks of held nerve.</p>
      <div class="cta-row">
        {
          firstWeek && (
            <a class="btn btn--solid" href={withBase(`/sessions/${firstWeek.id}/`)}>
              Start at Week 01
            </a>
          )
        }
        <a class="btn" href={withBase("/policies/")}>Read the policies</a>
      </div>
    </div>
    <ClaimStamp
      claim="I am a safe, competent hire."
      evidence="Three shipped repos, two references who'll take a call, one on-time delivery under real deadline pressure. The claim survives — this is what a truthfloor looks like once someone checks it."
    />
  </section>

  <section class="band band--soft">
    <ul class="course-tags" aria-label="Course tags">
      {courseMeta.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <p class="premise">
      Everybody you will ever interview with is performing a role they grew into. This
      course has you do it deliberately, name each move while you are making it, and hold
      one line for twelve weeks: framing what is true is professional practice; claiming
      what is not is fraud. Every technique taught here lives on one side of that line.
    </p>
    <dl class="facts">
      <div>
        <dt>Structure</dt>
        <dd>
          Twelve teaching weeks, one shared lecture and one stream tutorial each, with a
          break between weeks 6 and 7.
        </dd>
      </div>
      <div>
        <dt>Streams</dt>
        <dd>Three. Chosen in week 1 by how your target roles screen you, not your degree.</dd>
      </div>
      <div>
        <dt>Assessment</dt>
        <dd>
          {assessments.length} pieces, weighted {assessments.map((a) => a.data.weight).join(" + ")} = {totalWeight}%.
          Full briefs on the <a href={withBase("/assessments/")}>assessment page</a>.
        </dd>
      </div>
      <div>
        <dt>Convenor</dt>
        <dd>
          <a href={withBase("/people/wren-halloway/")}>
            {person("wren-halloway")?.data.title ?? "Dr Wren Halloway"}
          </a>, with three stream convenors and a practice fellow.
        </dd>
      </div>
    </dl>
  </section>

  <section class="band band--paper" aria-labelledby="streams-heading">
    <p class="eyebrow">Three streams, one lecture theatre</p>
    <h2 id="streams-heading">Choose by how the field screens you</h2>
    <div class="streams-grid">
      {
        streams.map((stream) => (
          <div class="stream-card">
            <p class="stream-card__n">Stream {String(stream.n).padStart(2, "0")} of 03</p>
            <h3>{stream.name}</h3>
            <p>{stream.tagline}</p>
            {stream.focus && <p class="stream-card__focus">Week 1 focus: {stream.focus}</p>}
            <p class="stream-card__convenor">
              Convened by <a href={withBase(`/people/${stream.convenor}/`)}>
                {person(stream.convenor)?.data.title ?? stream.convenor}
              </a>.
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <SemesterWeekGrid />

  <section class="band band--ink" aria-labelledby="ladder-heading">
    <p class="eyebrow">Assessment ladder</p>
    <h2 id="ladder-heading">{assessments.length} pieces, {totalWeight}% total</h2>
    <div class="ladder-bar">
      {
        assessments.map((a, i) => (
          <div class="ladder-seg" style={`width:${a.data.weight}%; background:${ladderColors[i % ladderColors.length]}`}>
            {a.data.weight}%
          </div>
        ))
      }
    </div>
    <div class="assess-grid">
      {
        assessments.map((a) => (
          <a class="assess-card" href={withBase(`/assessments/${a.id}/`)}>
            <span class="assess-card__w">{a.data.weight}%</span>
            <h3>{a.data.title}</h3>
            <p>Due week {a.data.week} · {formatCourseDate(a.data.due)}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="band band--soft" aria-labelledby="gloss-heading">
    <p class="eyebrow">Glossary, in progress</p>
    <h2 id="gloss-heading">The vocabulary builds week by week</h2>
    <div class="gloss-row">
      {
        glossPreview.map((session) => {
          const { term, termGloss } = extra(session);
          return term ? (
            <div class="gloss-card">
              <p class="gloss-card__term">{term}</p>
              <p>{termGloss}</p>
            </div>
          ) : null;
        })
      }
    </div>
    <p><a href={withBase("/glossary/")}>See every term defined so far →</a></p>
  </section>

  <section class="band band--paper">
    <p class="fine-print">
      <strong>The fine print, which is load-bearing.</strong> This course teaches framing,
      not fabrication, and the difference decides what you may put in an outreach message,
      what a Varnish Note has to admit, and who may be asked to sit on the other side of a
      practice interview. Where that line falls, who has consented to what, and what
      happens when somebody crosses it are all set out on the{" "}
      <a href={withBase("/policies/")}>policies page</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .hero__eyebrow {
    color: var(--evidence-text);
  }

  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 4px 10px;
    border: 1px solid var(--paper-line);
    color: var(--text-paper-dim);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .premise {
    max-width: 62ch;
    padding-inline-start: 20px;
    border-inline-start: 3px solid var(--evidence-fill);
    font-size: 17px;
  }

  .facts {
    display: grid;
    gap: 16px;
    margin: 32px 0 0;
    max-width: 60rem;
  }

  .facts > div {
    display: grid;
    gap: 4px;
    padding-block-end: 16px;
    border-block-end: 1px solid var(--paper-line);
  }

  .facts > div:last-child {
    padding-block-end: 0;
    border-block-end: none;
  }

  @media (width >= 40rem) {
    .facts > div {
      grid-template-columns: 11rem 1fr;
      gap: 16px;
    }
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-paper-dim);
  }

  .facts dd {
    margin: 0;
  }

  /* ---------- streams ----------
     .stream-card / .stream-card__* live in base.css: this page's even
     3-column grid is homepage-specific, but the card itself is shared with
     the session page's dark .stream-strip variant. */
  .streams-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    gap: 24px;
    margin-top: 32px;
  }

  @media (max-width: 900px) {
    .streams-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- assessment ladder ---------- */
  .ladder-bar {
    display: flex;
    height: 34px;
    margin: 28px 0;
    border: 1px solid var(--paper);
  }

  .ladder-seg {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: #fff;
  }

  .assess-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    background: var(--ink-line);
  }

  .assess-card {
    display: block;
    padding: 20px;
    background: var(--ink-soft);
    text-decoration: none;
    color: var(--text-ink);
  }

  .assess-card:hover,
  .assess-card:focus-visible {
    background: var(--paper);
  }

  .assess-card__w {
    font-family: var(--font-mono);
    font-size: 26px;
    font-weight: 700;
    color: var(--evidence-text);
  }

  .assess-card h3 {
    margin: 8px 0 6px;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 16px;
  }

  .assess-card p {
    margin: 0;
    font-size: 13.5px;
    color: var(--text-ink-dim);
  }

  @media (max-width: 900px) {
    .assess-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---------- glossary teaser ---------- */
  .gloss-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 32px 0 24px;
  }

  .gloss-card {
    padding: 20px;
    background: var(--paper);
    border: 1px solid var(--paper-line);
  }

  .gloss-card__term {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 15px;
    margin: 0 0 8px;
    color: var(--claim-text);
  }

  .gloss-card p:not(.gloss-card__term) {
    font-size: 13.5px;
    color: var(--text-paper-dim);
    margin: 0;
  }

  @media (max-width: 900px) {
    .gloss-row {
      grid-template-columns: 1fr;
    }
  }

  .fine-print {
    max-width: 62ch;
    font-size: 15px;
  }
</style>
