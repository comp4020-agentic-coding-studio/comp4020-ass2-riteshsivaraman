---
import { getPublishedCollection } from "astro-course-university/content";
import Callout from "astro-theme-university/components/Callout.astro";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import SemesterTracker from "../components/SemesterTracker.astro";
import { courseMeta } from "../course-config";
import { formatCourseDate } from "../lib/dates";
import { siteConfig } from "../site-config";

// No hero artwork: the gateway this course provisions exposes only chat
// models, so the site commits to a type-and-CSS treatment instead of stock
// imagery. `heroImage` is optional in ContentLayout.

const sessions = await getPublishedCollection("sessions");
const assessments = await getPublishedCollection("assessments");
const people = await getPublishedCollection("people");

const person = (slug: string) => people.find((p) => p.id === slug);

// The teases are each node's own `description:`, read from the content rather
// than rewritten here — a homepage that paraphrases its own pages drifts from
// them by week three.
const FEATURED = [1, 6, 9];
const featuredWeeks = sessions
  .filter((s) => FEATURED.includes(s.data.week))
  .sort((a, b) => a.data.week - b.data.week);
const capstone = assessments.find((a) => a.id === "04-capstone-applications");

const weights = [...assessments]
  .sort((a, b) => a.data.week - b.data.week)
  .map((a) => a.data.weight);
const totalWeight = weights.reduce((sum, w) => sum + w, 0);

// Streams are a curricular fact, not content nodes: the names and taglines are
// fixed by the course spec, but the convenor's name comes from their page so
// the two can never disagree.
const streams = [
  {
    name: "Technical Practice",
    tagline:
      "For the fields where the performance is competence, and someone will eventually ask you to open a terminal in front of them.",
    convenor: "anselm-pike",
  },
  {
    name: "Creative and Communications Practice",
    tagline:
      "For the fields where the performance is taste, and the portfolio is both the evidence and the alibi.",
    convenor: "nadia-ferrante",
  },
  {
    name: "Commercial and Public Practice",
    tagline:
      "For the fields where the performance is judgement, and nobody will ever ask to see the spreadsheet.",
    convenor: "sunil-raman",
  },
];
---

<div class="reading-progress" aria-hidden="true" role="presentation">
  <div class="reading-progress__fill" id="reading-progress-fill"></div>
</div>

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <p class="kv kv-bulge tagline-stamp" aria-hidden="true">Twelve weeks of held nerve.</p>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="premise">
    Everybody you will ever interview with is performing a role they grew into.
    This course has you do it deliberately, name each move while you are making
    it, and hold one line for twelve weeks: <strong data-field><span class="field-bg" aria-hidden="true"></span><span class="field-text">framing what is true is
    professional practice; claiming what is not is fraud.</span></strong> Every technique
    taught here lives on one side of that line.
  </p>

  <section class="orientation" aria-labelledby="orientation-heading">
    <h2 id="orientation-heading">The course, stated plainly</h2>
    <p
      class="live-counter"
      id="live-counter"
      aria-hidden="true"
      data-start-date={courseMeta.startDate}
      data-end-date={courseMeta.endDate}
    ></p>
    <dl class="facts">
      <div>
        <dt>Course code</dt>
        <dd>{courseMeta.code}</dd>
      </div>
      <div>
        <dt>Level</dt>
        <dd>{courseMeta.level}, undergraduate</dd>
      </div>
      <div>
        <dt>Teaching period</dt>
        <dd>
          {courseMeta.session} {courseMeta.year}, {formatCourseDate(courseMeta.startDate)} to {
            formatCourseDate(courseMeta.endDate)
          }
        </dd>
      </div>
      <div>
        <dt>Structure</dt>
        <dd>
          Twelve teaching weeks. One lecture a week, shared by everyone; one tutorial a
          week, run separately in each stream. A teaching break falls between weeks 6 and
          7.
        </dd>
      </div>
      <div>
        <dt>Streams</dt>
        <dd>
          Three. You choose one in week 1 by how your target roles screen you, not by what
          your degree is called. Attending another stream's tutorial is encouraged and
          never assessed.
        </dd>
      </div>
      <div>
        <dt>Prerequisite</dt>
        <dd>
          None. No field prerequisite, no prior applications, no portfolio you are
          embarrassed by that would disqualify you.
        </dd>
      </div>
      <div>
        <dt>Assessment</dt>
        <dd>
          {assessments.length} pieces, weighted {weights.join(" + ")} = {totalWeight}%. Full
          briefs and criteria on the <a href={withBase("/assessments/")}>assessment page</a>.
        </dd>
      </div>
      <div>
        <dt>Convenor</dt>
        <dd>
          <a href={withBase("/people/wren-halloway/")}>
            {person("wren-halloway")?.data.title ?? "Dr Wren Halloway"}
          </a>, with three stream convenors and a practice fellow.
        </dd>
      </div>
    </dl>
  </section>

  <SemesterTracker />

  <section aria-labelledby="start-here-heading">
    <h2 id="start-here-heading">Four pages that show what actually happens</h2>
    <p>
      Everything is one click from the navigation. These four are the ones worth opening
      first, because they are where the course stops describing itself and starts running.
    </p>

    <CardGrid columns={2}>
      {
        featuredWeeks.map((week) => (
          <Card
            headingLevel="h3"
            title={`Week ${week.data.week}: ${week.data.title}`}
            href={`/sessions/${week.id}/`}
          >
            {week.data.description && <p>{week.data.description}</p>}
          </Card>
        ))
      }
      {
        capstone && (
          <Card
            headingLevel="h3"
            title={capstone.data.title}
            href={`/assessments/${capstone.id}/`}
          >
            {capstone.data.description && <p>{capstone.data.description}</p>}
            <p>
              <small>
                Worth {capstone.data.weight}% · graded on the process record, never on
                whether anyone said yes
              </small>
            </p>
          </Card>
        )
      }
    </CardGrid>

    <p class="deck-note">
      Week 6 is the flagship. Its lecture ships as slides rather than a page, because two
      versions of the same artefact side by side is a slide and not a paragraph:{" "}
      <a href={withBase("/decks/week-06-varnish/")}>Varnish, and How Much Is Too Much</a>.
    </p>
  </section>

  <section aria-labelledby="streams-heading">
    <h2 id="streams-heading">Three streams, one lecture theatre</h2>
    <p>
      The streams do not partition by discipline — a health-informatics student and a civil
      engineer land in the same room. They partition by how the field screens candidates,
      because that is what you are preparing for.
    </p>
    <ul class="streams">
      {
        streams.map((stream) => {
          const convenor = person(stream.convenor);
          return (
            <li>
              <h3 class={`stream-heading stream-heading--${stream.convenor}`}>{stream.name}</h3>
              <p class="stream-tagline">{stream.tagline}</p>
              <p class="stream-convenor">
                Convened by{" "}
                <a href={withBase(`/people/${stream.convenor}/`)}>
                  {convenor?.data.title ?? stream.convenor}
                </a>
                .
              </p>
            </li>
          );
        })
      }
    </ul>
  </section>

  <Callout type="info">
    <p>
      <strong>The fine print, which is load-bearing.</strong> This course teaches framing, not
      fabrication, and the difference is not a slogan — it decides what you may put in an
      outreach message, what a Varnish Note has to admit, and who may be asked to sit on the
      other side of a practice interview. Where that line falls, who has consented to what,
      and what happens when somebody crosses it are all set out on the{" "}
      <a href={withBase("/policies/")}>policies page</a>, along with extensions and the
      people to ask.
    </p>
  </Callout>
</ContentLayout>

<script is:inline data-astro-rerun>
  (function () {
    /* ---------- reading progress bar --------------------------------
     * rAF-throttled scroll listener; fixed hairline filled in --at-accent.
     * Decorative only (aria-hidden on the wrapper in markup), so no
     * announcement policy is needed here. */
    var fill = document.getElementById("reading-progress-fill");
    if (fill) {
      var ticking = false;
      var update = function () {
        ticking = false;
        var doc = document.documentElement;
        var max = doc.scrollHeight - doc.clientHeight;
        var pct = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        fill.style.transform = "scaleX(" + pct + ")";
      };
      var onScroll = function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }

    /* ---------- live week/date counter ------------------------------
     * Computed from the course's own start/end dates, not hardcoded.
     * Visual-only chrome: aria-hidden in markup, no live region, because
     * the fact itself is already stated in the .facts dl below it. */
    var counter = document.getElementById("live-counter");
    if (counter) {
      var DAY = 86400000;
      var WEEK = 7 * DAY;
      var toUTC = function (iso) {
        var p = iso.split("-").map(Number);
        return Date.UTC(p[0], p[1] - 1, p[2]);
      };
      var start = toUTC(counter.getAttribute("data-start-date") || "");
      var end = toUTC(counter.getAttribute("data-end-date") || "");
      var render = function () {
        var now = new Date();
        var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
        var text;
        if (today < start) {
          var days = Math.round((start - today) / DAY);
          text = days === 0
            ? "Teaching starts today."
            : "Teaching starts in " + days + (days === 1 ? " day." : " days.");
        } else if (today > end + WEEK) {
          text = "Teaching finished this semester.";
        } else {
          var week = Math.min(12, Math.floor((today - start) / WEEK) + 1);
          text = "Currently week " + week + " of 12.";
        }
        counter.textContent = text;
      };
      render();
      window.setInterval(render, 60000);
    }

    /* ---------- accent-field wipe reveal ----------------------------
     * scaleX transform mask, triggered once by IntersectionObserver.
     * Renders already-revealed under reduced motion via the CSS branch
     * below; no JS branch needed since .lit only adds the class either
     * way and the transition duration collapses to ~0 there. */
    var fields = document.querySelectorAll("[data-field]");
    if (fields.length) {
      if ("IntersectionObserver" in window) {
        var fo = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("lit");
                fo.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.6 },
        );
        fields.forEach(function (f) {
          fo.observe(f);
        });
      } else {
        fields.forEach(function (f) {
          f.classList.add("lit");
        });
      }
    }

    /* ---------- text scramble / resolve on the h1 -------------------
     * Selects the library-rendered <h1> after render. Run-token guard so
     * a re-trigger (e.g. astro:page-load on back/forward nav) can never
     * race two loops writing competing glyphs to the same node. */
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var heading = document.querySelector(".at-main h1");
    if (heading && !reduced) {
      var GLYPHS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ/#%&*+=—";
      var final = heading.dataset.scrambleFinal || (heading.dataset.scrambleFinal = heading.textContent || "");
      var run = (heading.dataset.scrambleRun = String(Number(heading.dataset.scrambleRun || "0") + 1));
      var n = final.length;
      var total = 26;
      var order = final.split("").map(function (_, i) {
        return i / n;
      });
      var frames = 0;
      var step = function () {
        if (heading.dataset.scrambleRun !== run) return;
        var p = frames / total;
        var out = "";
        for (var i = 0; i < n; i++) {
          var ch = final[i];
          if (ch === " " || ch === ":") {
            out += ch;
            continue;
          }
          out += p > order[i] + 0.22 ? ch : GLYPHS[(Math.random() * GLYPHS.length) | 0];
        }
        heading.textContent = out;
        frames++;
        if (frames <= total) requestAnimationFrame(step);
        else heading.textContent = final;
      };
      step();
    }
  })();
</script>

<style>
  /* ---- reading progress bar (decorative, aria-hidden in markup) -------- */
  .reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 80;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress__fill {
    height: 100%;
    width: 100%;
    background: var(--at-accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress__fill {
      transition: none;
    }
  }

  /* ---- tagline stamp: short, hand-authored, safe for .kv's nowrap lock -- */
  .tagline-stamp {
    margin-block: 0 var(--at-spacing-lg);
    color: var(--at-text-secondary);
    font-size: clamp(1.1rem, 4vw, 1.6rem);
  }

  /* ---- accent-field wipe reveal ----------------------------------------
   * .field-bg is an absolutely positioned plate behind the phrase, scaled
   * to 0 on the inline axis and revealed via scaleX on `.lit` (added by the
   * IntersectionObserver in the page script). Reduced motion renders the
   * end state immediately rather than animating into it. */
  [data-field] {
    position: relative;
    display: inline-block;
    padding-inline: 0.1em;
    margin-inline: -0.1em;
  }

  .field-bg {
    position: absolute;
    inset: -0.05em -0.02em;
    z-index: 0;
    background: var(--at-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .field-text {
    position: relative;
    z-index: 1;
  }

  [data-field].lit .field-bg {
    transform: scaleX(1);
  }

  [data-field].lit .field-text {
    color: var(--at-bg);
  }

  @media (prefers-reduced-motion: reduce) {
    .field-bg {
      transition: none;
    }
  }

  /* ---- live week/date counter: visual chrome only, aria-hidden --------- */
  .live-counter {
    margin-block: 0 var(--at-spacing-md);
    padding-block: 0.3rem 0;
    color: var(--at-accent);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* ---- per-stream fixed axis bias: distinct at rest, no animation ------
   * Same wght/wdth axes the live signature drives, fixed rather than
   * scroll-linked, so the three streams read as typographically distinct
   * even when nothing is moving. Direction is a settled design decision:
   * technical = narrow + heavy, creative = wide + light, commercial = mid. */
  .stream-heading {
    font-family: var(--at-font-display);
  }

  .stream-heading--anselm-pike {
    font-variation-settings:
      "wght" 750,
      "wdth" 85;
  }

  .stream-heading--nadia-ferrante {
    font-variation-settings:
      "wght" 450,
      "wdth" 96;
  }

  .stream-heading--sunil-raman {
    font-variation-settings:
      "wght" 600,
      "wdth" 90;
  }

  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  /* Filing tags, not pills --- the one hardcoded radius on the site, and it
     survived the rebrand because it never read `--at-border-radius`. Typed and
     boxed to match the rest of the institutional apparatus. */
  .course-tags li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--at-border);
    color: var(--at-text-secondary);
    background: transparent;
    font-family: var(--at-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .premise {
    padding-inline-start: var(--at-spacing-md);
    border-inline-start: 3px solid var(--at-accent);
  }

  .orientation {
    margin-block: var(--at-spacing-2xl);
  }

  /* Deliberately a definition list rather than a prose paragraph: this is the
     block a marker scans for the institutional facts, and a scan wants labels
     in a column. */
  .facts {
    display: grid;
    gap: var(--at-spacing-md);
    margin: 0;
  }

  .facts > div {
    display: grid;
    gap: var(--at-spacing-xs);
    padding-block-end: var(--at-spacing-md);
    border-block-end: 1px solid var(--at-divider);
  }

  .facts > div:last-child {
    padding-block-end: 0;
    border-block-end: none;
  }

  @media (width >= 40rem) {
    .facts > div {
      grid-template-columns: 11rem 1fr;
      gap: var(--at-spacing-md);
    }
  }

  .facts dt {
    font-size: var(--at-font-size-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .facts dd {
    margin: 0;
  }

  .deck-note {
    padding: var(--at-spacing-md);
    border: 1px dashed var(--at-border);
    border-radius: var(--at-border-radius);
  }

  .streams {
    display: grid;
    gap: var(--at-spacing-lg);
    margin-block: var(--at-spacing-lg);
    padding: 0;
    list-style: none;
  }

  .streams > li {
    padding-inline-start: var(--at-spacing-md);
    border-inline-start: 3px solid var(--at-border);
  }

  .streams h3 {
    margin-block: 0 var(--at-spacing-xs);
  }

  .stream-tagline {
    margin-block: 0;
  }

  .stream-convenor {
    margin-block: var(--at-spacing-xs) 0;
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
  }
</style>
