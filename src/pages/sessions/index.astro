---
import ContentLayout from "../../layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={`Weekly ${sessionLabels.plural}`}
  description="Twelve tutorials, no two run the same way, each one adding a numbered section to the Dossier."
  {...siteConfig}
>
  <p>
    One page per week, carrying all three streams: the lecture is shared, the
    tutorial rooms are not, so each page ends with what your stream does
    differently. A teaching break falls between weeks 6 and 7, and the
    instruction for it is to build rather than polish.
  </p>
  <p>
    Every week coins one term, collected on the <a href={withBase("/glossary/")}>glossary</a
    >.
  </p>
  <SessionsGrid />
</ContentLayout>
