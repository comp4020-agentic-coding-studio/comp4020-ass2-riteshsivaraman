---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = (await getPublishedCollection("sessions")).sort((a, b) => a.data.week - b.data.week);
  return sessions.map((session, i) => ({
    params: { slug: session.id },
    props: { session, prev: sessions[i - 1], next: sessions[i + 1] },
  }));
}

const { session, prev, next } = Astro.props;
const { Content } = await render(session);

// `format`/`term`/`termGloss`/`streams` come through courseNodeSchema's
// `.loose()` passthrough (src/content.config.ts), so Astro/Zod types them as
// `unknown` at the call site — cast here rather than widen the shared schema
// from a page outside this task's write scope (same approach index.astro
// takes).
interface SessionExtra {
  format?: string;
  term?: string;
  termGloss?: string;
  streams?: { name: string; slug: string; focus?: string }[];
}
const extra = session.data as unknown as SessionExtra;
const streams = extra.streams ?? [];
---

<BaseLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description ?? undefined}
  favicon={siteConfig.favicon}
>
  <section class="band band--ink wk-header">
    <p class="eyebrow">
      Week {String(session.data.week).padStart(2, "0")} · {formatCourseDate(session.data.date)} ·{" "}
      {sessionLabels.singular}
    </p>
    <h1 class="h-display">{session.data.title}</h1>
    {session.data.description && <p class="lead">{session.data.description}</p>}
    {extra.format && <span class="tagpill">{extra.format}</span>}
  </section>

  {
    extra.term && extra.termGloss && (
      <div class="term-band">
        <div class="term-card">
          <p class="term-card__label">Term of the week</p>
          <p><span class="term-card__term">{extra.term}</span> — {extra.termGloss}</p>
        </div>
      </div>
    )
  }

  <section class="band band--paper">
    <div class="week-body" data-week-body>
      <Content />
    </div>
  </section>

  {
    streams.length > 0 && (
      <section class="band band--soft" aria-labelledby="stream-heading">
        <div class="section-head">
          <p class="eyebrow">This week, by stream</p>
          <h2 id="stream-heading">Your stream's version</h2>
        </div>
        <div class="stream-strip">
          {streams.map((stream, i) => (
            <div class="stream-card">
              <p class="stream-card__n">Stream {String(i + 1).padStart(2, "0")} of {String(streams.length).padStart(2, "0")}</p>
              <h3>{stream.name}</h3>
              {stream.focus && <p class="stream-card__focus">{stream.focus}</p>}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="band band--paper">
    <TeachingTeam teachers={session.data.teachers} />
    <RelatedContent entry={session} collections={graphCollections} />
  </section>

  <nav class="pagefoot" aria-label="Week navigation">
    {prev ? <a href={withBase(`/sessions/${prev.id}/`)}>← Week {prev.data.week}</a> : <span />}
    <span class="pagefoot__spacer" />
    {next ? <a href={withBase(`/sessions/${next.id}/`)}>Week {next.data.week} →</a> : <span />}
  </nav>
</BaseLayout>

<script is:inline data-astro-rerun>
  /**
   * Progressive enhancement, not a load-bearing behaviour: every week's body
   * uses whatever ## heading names actually fit its content (confirmed by
   * grepping all twelve — only "Leaving with" is consistent, and only ten of
   * twelve keep it as the last heading). Rather than hardcode a heading name
   * into the markdown-render pipeline, this lifts whichever heading matches
   * "leaving with" — and everything after it — out of the two-column split
   * and into its own full-width band, client-side. With JS off the content
   * is still fully present, just inline in the two-column flow instead of
   * broken into a distinct band.
   */
  (function () {
    var body = document.querySelector("[data-week-body]");
    if (!body) return;
    var headings = Array.prototype.slice.call(body.querySelectorAll("h2"));
    var target = headings.find(function (h) {
      return /^leaving with/i.test((h.textContent || "").trim());
    });
    if (!target) return;

    var lifted = [];
    var node = target;
    while (node) {
      var nextNode = node.nextElementSibling;
      lifted.push(node);
      node = nextNode;
    }

    var band = document.createElement("div");
    band.className = "leaving-band";
    lifted.forEach(function (el) {
      band.appendChild(el);
    });
    body.insertAdjacentElement("afterend", band);
  })();
</script>
