---
/**
 * Restyled for the Night Terminal identity. Renders inside a band the
 * caller already provides (sessions/[slug].astro and lectures/[slug].astro
 * both nest it in a `band band--paper`), so this owns no band of its own —
 * just the `section-head` heading row plus a compact person-strip that
 * matches the mono-label treatment used across the site's cards.
 */
import { getEntries, type CollectionEntry } from "astro:content";
import { withBase } from "astro-theme-university/url";

interface Props {
  teachers: CollectionEntry<"sessions">["data"]["teachers"] | CollectionEntry<"lectures">["data"]["teachers"];
}

const { teachers } = Astro.props;
// A session or lecture with no `teachers:` renders no team at all.
const people = teachers ? await getEntries(teachers) : [];

function asLabel(role: string): string {
  return role.charAt(0).toUpperCase() + role.slice(1);
}
---

{
  people.length > 0 && (
    <section class="teaching-team" aria-labelledby="teaching-team-heading">
      <div class="section-head">
        <p class="eyebrow">Who's running this one</p>
        <h2 id="teaching-team-heading">Teaching team</h2>
      </div>
      <ul class="teaching-team__list">
        {people.map((person) => (
          <li class="teaching-team__item">
            <a href={withBase(`/people/${person.id}/`)}>{person.data.title}</a>
            <span class="teaching-team__role">{asLabel(person.data.role)}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .teaching-team {
    margin-top: 8px;
  }

  .teaching-team__list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .teaching-team__item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--paper-soft);
    border: 1px solid var(--paper-line);
    padding: 12px 18px;
  }

  .teaching-team__item a {
    font-weight: 600;
    color: var(--text-paper);
  }

  .teaching-team__role {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-paper-dim);
  }

  @media (max-width: 720px) {
    .teaching-team__list {
      flex-direction: column;
    }

    .teaching-team__item {
      width: 100%;
    }
  }
</style>
