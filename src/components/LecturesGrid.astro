---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.week - b.data.week);

// `slides` comes through courseNodeSchema's `.loose()` passthrough, so the
// call site sees `unknown` — cast rather than widen the shared schema from a
// component outside that task's write scope (same approach sessions/[slug].astro
// takes for its own passthrough fields).
interface LectureExtra {
  slides?: string;
}
const extra = (l: (typeof visible)[number]) => l.data as unknown as LectureExtra;
---

<div class="lecture-grid">
  {
    visible.map((lecture) => (
      <a class="lecture-card" href={withBase(`/lectures/${lecture.id}/`)}>
        <p class="lecture-card__n">
          Week {String(lecture.data.week).padStart(2, "0")} · {formatCourseDate(lecture.data.date)}
        </p>
        <h2 class="lecture-card__title">{lecture.data.title}</h2>
        {lecture.data.description && <p class="lecture-card__desc">{lecture.data.description}</p>}
        {extra(lecture).slides && <span class="lecture-card__tag">Runs from slides</span>}
      </a>
    ))
  }
</div>

<style>
  .lecture-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--paper-line);
  }

  .lecture-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 28px;
    background: var(--paper);
    color: var(--text-paper);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .lecture-card:hover,
  .lecture-card:focus-visible {
    background: var(--paper-soft);
  }

  .lecture-card__n {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-paper-dim);
  }

  .lecture-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 19px;
    line-height: 1.15;
  }

  .lecture-card__desc {
    margin: 0;
    font-size: 14.5px;
    color: var(--text-paper-dim);
    flex: 1;
  }

  .lecture-card__tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--evidence-fill);
    color: var(--evidence-text);
    padding: 4px 10px;
  }

  @media (max-width: 720px) {
    .lecture-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
