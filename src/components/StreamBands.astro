---
/**
 * Renders a session's structured `streams:` frontmatter as three full-bleed
 * bands — the "dense structural core" design/option-a/README.md's inner.html
 * section describes. Each band is opened by an enormous single-letter glyph
 * in a gutter column, and the three streams are made typographically
 * distinct by a fixed per-stream font-variation-settings bias (settled
 * project decision: axis-bias per stream, not colour).
 *
 * This does NOT replace the inline prose in the markdown body, which stays
 * as-is — this is an additional structured index sitting alongside it.
 *
 * A small section rail (one link per band) tracks scroll position via
 * IntersectionObserver and highlights the in-view band.
 */
interface Stream {
  name: string;
  slug: string;
  focus?: string;
}

interface Props {
  // `streams` isn't in courseNodeSchema (src/content.config.ts) — it comes
  // through that schema's `.loose()` passthrough, so Astro/Zod types it as
  // `unknown` at the call site. Typed loosely here on purpose and cast
  // below, rather than widening the shared content schema from a component
  // outside this task's write scope.
  streams: unknown;
}

const { streams: rawStreams } = Astro.props;
const streams = (Array.isArray(rawStreams) ? rawStreams : []) as Stream[];

// One glyph per band: A/B/C by array index, per design/option-a/README.md's
// "enormous A/B/C glyph in the gutter". Index-based rather than
// slug-first-letter, because two of the three slugs collide on their first
// letter (creative/commercial both start with C).
const glyphFor = (index: number) => String.fromCharCode(65 + index);
---

{
  streams && streams.length > 0 && (
    <section class="stream-bands" aria-label="Field streams" data-stream-bands>
      <nav class="stream-rail" aria-label="Session sections">
        <ul class="stream-rail__list">
          {streams.map((stream, index) => (
            <li>
              <a
                class={`stream-rail__link stream-rail__link--${stream.slug}`}
                href={`#stream-${stream.slug}`}
                data-slug={stream.slug}
                aria-label={stream.name}
              >
                <span aria-hidden="true">{glyphFor(index)}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="stream-bands__list">
        {streams.map((stream, index) => (
          <article class={`stream-band stream-${stream.slug}`} data-slug={stream.slug}>
            <span class="stream-band__glyph kv" aria-hidden="true">
              {glyphFor(index)}
            </span>
            <div class="stream-band__body">
              <h2 class="stream-heading" id={`stream-${stream.slug}`}>
                {stream.name}
              </h2>
              {stream.focus && <p class="stream-focus">{stream.focus}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  /* ---- Layout: bleed into the accent-rule inset, same span .at-main
     itself uses — the widest column available to a subgridded child. ---- */
  .stream-bands {
    grid-column: inset-start / content-end;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--at-spacing-xl);
    margin-block: var(--at-spacing-xl);
  }

  .stream-bands__list {
    grid-column: inset-start / content-end;
    display: grid;
  }

  /* ---- Bands: full-bleed rules doing the job cards would otherwise do. */
  .stream-band {
    display: grid;
    grid-template-columns: minmax(3.5rem, 12%) 1fr;
    align-items: start;
    column-gap: var(--at-spacing-lg);
    padding-block: var(--at-spacing-xl);
    border-block-start: 1.5px solid var(--at-text);
  }

  .stream-band:last-child {
    border-block-end: 1.5px solid var(--at-text);
  }

  /* ---- The gutter glyph: `.kv` carries the live velocity signature (safe
     here — a single character, reserved in `em`, never reflows). The
     per-stream custom properties below ADD a fixed bias on top of the live
     value via calc(), so the three streams stay visually distinct even at
     rest, not only mid-scroll. */
  .stream-band__glyph {
    font-size: clamp(4.5rem, 14vw, 9rem);
    color: var(--at-text);
    font-variation-settings:
      "wght" calc(var(--kv-wght) + var(--np-stream-bias-wght, 0)),
      "wdth" calc(var(--kv-wdth) + var(--np-stream-bias-wdth, 0));
  }

  .stream-band__body {
    padding-block-start: var(--at-spacing-sm);
  }

  /* Headings get the bias but NOT `.kv` — a stream name is long, arbitrary
     content-authored text, exactly the case the live signature's geometry
     lock (`white-space: nowrap`) is not safe for. The bias is composed
     against the engine's own rest value (380/92) so it reads as the same
     fixed identity the glyph settles to when the page is still. */
  .stream-heading {
    font-family: var(--at-font-display);
    font-variation-settings:
      "wght" calc(380 + var(--np-stream-bias-wght, 0)),
      "wdth" calc(92 + var(--np-stream-bias-wdth, 0));
    text-transform: uppercase;
    letter-spacing: -0.005em;
    border-block-end: 0;
    padding-block-end: 0;
    margin-block: 0 0.35em;
    font-size: var(--at-font-size-h2);
  }

  .stream-focus {
    max-width: 34ch;
    color: var(--at-text-secondary);
  }

  /* ---- Per-stream axis bias: fixed, not colour. Technical Practice reads
     narrower/heavier; Creative and Communications wider/lighter; Commercial
     and Public Practice sits at the engine's own baseline (no bias) so it
     reads as the mid-point between the other two. */
  .stream-technical {
    --np-stream-bias-wght: 190;
    --np-stream-bias-wdth: -22;
  }

  .stream-creative {
    --np-stream-bias-wght: -150;
    --np-stream-bias-wdth: 28;
  }

  .stream-commercial {
    --np-stream-bias-wght: 0;
    --np-stream-bias-wdth: 0;
  }

  /* ---- 390px: the outlined glyph at a narrow width axis collapses into an
     unreadable domino at this size (design/option-a/README.md's own call),
     so the mobile treatment swaps to the one accent colour instead of
     scaling the desktop outline down. */
  @media (width < 640px) {
    .stream-band {
      grid-template-columns: 1fr;
      row-gap: var(--at-spacing-sm);
    }

    .stream-band__glyph {
      color: var(--np-volt);
      font-size: clamp(4rem, 26vw, 6rem);
    }

    .stream-band__body {
      padding-block-start: 0;
    }
  }

  /* ---- Section rail --------------------------------------------------- */
  .stream-rail {
    grid-column: inset-start / content-end;
    position: sticky;
    top: calc(var(--at-nav-height) + var(--at-spacing-sm));
    z-index: 5;
    background: var(--at-bg);
    border-block-end: 1px solid var(--at-divider);
    padding-block: var(--at-spacing-xs);
  }

  .stream-rail__list {
    display: flex;
    gap: var(--at-spacing-md);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .stream-rail__list::-webkit-scrollbar {
    display: none;
  }

  .stream-rail__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2rem;
    block-size: 2rem;
    flex: none;
    font-family: var(--at-font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--at-text-secondary);
    border: 1px solid var(--at-border);
    text-decoration: none;
  }

  .stream-rail__link:hover {
    color: var(--at-text);
    border-color: var(--at-text);
  }

  .stream-rail__link.is-active {
    color: var(--at-bg);
    background: var(--np-volt);
    border-color: var(--np-volt);
  }
</style>

<script is:inline data-astro-rerun>
  // Section rail: highlights the band currently in view, and keeps the
  // active rail item scrolled into view on narrow viewports where the rail
  // scrolls horizontally. Runs once per page (one StreamBands instance).
  // Plain JS (no TS syntax) to match this repo's other inline component
  // scripts (see SemesterTracker.astro).
  (function () {
    var root = document.querySelector("[data-stream-bands]");
    if (!root) return;

    var headings = Array.prototype.slice.call(root.querySelectorAll(".stream-heading"));
    var links = {};
    var linkList = Array.prototype.slice.call(root.querySelectorAll(".stream-rail__link"));
    linkList.forEach(function (link) {
      links[link.dataset.slug] = link;
    });

    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function setActive(slug) {
      if (!slug || !links[slug]) return;
      linkList.forEach(function (link) {
        link.classList.toggle("is-active", link.dataset.slug === slug);
      });
      links[slug].scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        inline: "center",
        block: "nearest",
      });
    }

    if ("IntersectionObserver" in window && headings.length > 0) {
      // rootMargin flips the "active" band around roughly a third of the
      // way down the viewport, replicating design/option-a's
      // innerHeight * 0.32 crossing point.
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var band = entry.target.closest("[data-slug]");
              if (band) setActive(band.dataset.slug);
            }
          });
        },
        { rootMargin: "-32% 0px -60% 0px", threshold: 0 },
      );

      headings.forEach(function (heading) {
        observer.observe(heading);
      });
    } else if (headings.length > 0) {
      // No IntersectionObserver support: just mark the first band active
      // so the rail is never in a stateless, ambiguous position.
      var firstBand = headings[0].closest("[data-slug]");
      if (firstBand) setActive(firstBand.dataset.slug);
    }
  })();
</script>
