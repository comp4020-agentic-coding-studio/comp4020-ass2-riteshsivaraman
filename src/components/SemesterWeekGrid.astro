---
/**
 * "Where the semester goes" — a self-contained, self-fetching band showing
 * all twelve weeks as a grid of boxes (big for orientation/pivot weeks,
 * flagged where an assessment is due). Extracted from the home page so
 * `sessions/index.astro` can render the same block instead of duplicating
 * markup — the only place this grid appears now, replacing the separate
 * "where the semester is" list that used to live on that page too.
 */
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const sessions = (await getPublishedCollection("sessions")).sort((a, b) => a.data.week - b.data.week);
const assessments = (await getPublishedCollection("assessments")).sort((a, b) => a.data.week - b.data.week);
const dueByWeek = new Map(assessments.map((a) => [a.data.week, a]));

// `format` comes through courseNodeSchema's `.loose()` passthrough
// (src/content.config.ts), so Astro/Zod types it as `unknown` at the call
// site — cast here rather than widen the shared schema from a component
// outside this task's write scope (same approach index.astro already takes).
interface SessionExtra {
  format?: string;
}
const extra = (s: (typeof sessions)[number]) => s.data as unknown as SessionExtra;
---

<section class="band band--soft" aria-labelledby="weeks-heading">
  <p class="eyebrow">The twelve weeks</p>
  <h2 id="weeks-heading">Where the semester goes</h2>
  <div class="week-grid">
    {
      sessions.map((session) => {
        const due = dueByWeek.get(session.data.week);
        const big = session.data.week === 1 || session.data.week === 6;
        return (
          <a
            class={`wk${big ? " wk--big" : ""}${due ? " wk--due" : ""}`}
            href={withBase(`/sessions/${session.id}/`)}
          >
            <span class="wk__n">Week {String(session.data.week).padStart(2, "0")}</span>
            <span class="wk__t">{session.data.title}</span>
            {extra(session).format && <span class="wk__tag">{extra(session).format}</span>}
            {due && <span class="wk__flag">{due.data.weight}% due</span>}
          </a>
        );
      })
    }
  </div>
</section>

<style>
  .week-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 150px;
    gap: 10px;
    margin-top: 32px;
  }

  .wk {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
    padding: 16px;
    border: 2px solid var(--paper-line);
    background: var(--paper);
    text-decoration: none;
    color: var(--text-paper);
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  .wk:hover,
  .wk:focus-visible {
    border-color: var(--evidence-fill);
    transform: translateY(-4px);
  }

  .wk--big {
    grid-column: span 2;
    grid-row: span 2;
    background: var(--evidence-fill);
    color: #fff;
    border-color: var(--evidence-fill);
  }

  .wk--big .wk__t {
    font-size: 24px;
  }

  .wk--big:hover {
    background: var(--evidence-text);
  }

  .wk--due {
    border-color: var(--claim-fill);
  }

  .wk__n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-paper-dim);
  }

  .wk__t {
    font-weight: 600;
    font-size: 15px;
    flex: 1;
  }

  .wk__tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--text-paper-dim);
  }

  .wk__flag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--claim-text);
    font-weight: 600;
  }

  .wk--big .wk__flag {
    color: #ffe3d6;
  }

  @media (max-width: 900px) {
    .week-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 130px;
    }

    .wk--big {
      grid-row: span 1;
      grid-column: span 2;
    }
  }
</style>
