---
/**
 * The course lexicon, aggregated rather than retyped: `term:` and `termGloss:`
 * are authored once on the session that teaches the term, and this reads them
 * back out. Nothing here can drift from the week pages, because there is only
 * one copy.
 *
 * Both keys ride the session schema's `.loose()` passthrough, so they arrive
 * untyped and are read through a narrow string accessor.
 */
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

function readString(data: unknown, key: string): string | undefined {
  const value = (data as Record<string, unknown>)[key];
  return typeof value === "string" && value.trim() !== "" ? value : undefined;
}

const sessions = (await getPublishedCollection("sessions")).sort(
  (a, b) => a.data.week - b.data.week,
);

// Ordered by the week that coins the term, not alphabetically: the lexicon
// cross-references itself forwards (receipt debt is what the plausibility
// budget is spent on), so reading it in teaching order is reading it in the
// order it makes sense.
const entries = sessions.flatMap((session) => {
  const term = readString(session.data, "term");
  const gloss = readString(session.data, "termGloss");
  if (!term || !gloss) return [];
  return [
    {
      term,
      gloss,
      week: session.data.week,
      title: session.data.title,
      href: withBase(`/sessions/${session.id}/`),
      anchor: term.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
    },
  ];
});
---

<section class="band band--paper" aria-labelledby="glossary-heading">
  <p class="eyebrow">Coined week by week, in teaching order</p>
  <h2 id="glossary-heading">The lexicon</h2>
  <dl class="glossary">
    {
      entries.map((entry) => (
        <div class="glossary-entry">
          <dt id={entry.anchor}>
            <span class="glossary-entry__n">Week {String(entry.week).padStart(2, "0")}</span>
            <span class="glossary-entry__term">{entry.term}</span>
          </dt>
          <dd>
            <p class="glossary-gloss">{entry.gloss}</p>
            <p class="glossary-source">
              <a href={entry.href}>
                Week {entry.week}: {entry.title} →
              </a>
            </p>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .glossary {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .glossary-entry {
    background: var(--paper-soft);
    border: 1px solid var(--paper-line);
    border-left: 4px solid var(--evidence-fill);
    padding: 22px 26px;
  }

  .glossary-entry__n {
    display: block;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-paper-dim);
    margin-bottom: 8px;
  }

  .glossary-entry__term {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 19px;
    letter-spacing: -0.01em;
    color: var(--text-paper);
  }

  .glossary dd {
    margin: 12px 0 0;
  }

  .glossary-gloss {
    margin: 0 0 10px;
    font-size: 15px;
    line-height: 1.55;
  }

  .glossary-source {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.02em;
  }

  .glossary-source a {
    color: var(--evidence-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .glossary {
      grid-template-columns: 1fr;
    }
  }
</style>
