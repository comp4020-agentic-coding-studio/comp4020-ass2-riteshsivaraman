---
/**
 * The sticky left rail: brand, theme toggle, and course navigation.
 *
 * Links are read straight from `siteConfig.links` — never hardcoded here —
 * so the rail can never drift from the single flat list the rest of the
 * site treats as the nav's source of truth. `aria-current="page"` is
 * derived from the current URL rather than passed in, so it stays correct
 * on every route without each page having to say which link is "its own".
 *
 * The compact 12-tick audit tracker lives here, in the rail, because it's
 * meant to stay visible on every page as you navigate the course — not just
 * the homepage. Its week/state computation comes from `lib/semester.ts`,
 * shared so nothing else that shows "current week" can disagree with it.
 */
import { siteConfig } from "../site-config";
import { withBase } from "astro-theme-university/url";
import { getSemesterWeeks } from "../lib/semester";

const links = siteConfig.links ?? [];
const currentPath = Astro.url.pathname;

const { weeks } = await getSemesterWeeks();
const current = weeks.find((w) => w.state === "current");
const taught = weeks.filter((w) => w.state === "past").length + (current ? 1 : 0);
const trackerLabel = current ? `WK ${current.week}/${weeks.length}` : `${taught}/${weeks.length}`;

// A link is "current" if the page path matches it exactly, or sits under it
// as a nested route (e.g. /sessions/week-01/ under /sessions/) — but never
// for "/" itself, which would otherwise match every route's leading slash.
const isCurrent = (href: string) => {
  const base = withBase(href);
  const normalise = (p: string) => (p.endsWith("/") ? p : `${p}/`);
  if (base === withBase("/")) return normalise(currentPath) === normalise(base);
  return normalise(currentPath).startsWith(normalise(base));
};

// The tracker grid's "selected" tick is a navigation-state fact — which
// week's page you're actually looking at right now — distinct from
// `w.state === "current"`, which is a calendar fact about the semester.
// `w.href` (from lib/semester.ts) already points at `/sessions/<id>/` with
// base applied; a lecture page for the same week counts too, so the
// highlight still fires from /lectures/week-06/, not only /sessions/week-06/.
const normalisePath = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const selectedWeek = weeks.find((w) => {
  const weekId = w.href.split("/").filter(Boolean).pop();
  const path = normalisePath(currentPath);
  return path === normalisePath(w.href) || path === normalisePath(withBase(`/lectures/${weekId}/`));
});
---

<aside class="rail" id="rail">
  <div class="brand">
    <div>
      <a
        class="brand__logo"
        href="https://slop.university/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Slop University (opens the university site in a new tab)"
      >
        <img
          class="brand__logo-img brand__logo-img--light"
          src={withBase("/brand/slop-university-gold-black.svg")}
          alt="Slop University"
          width="278"
          height="43"
        />
        <img
          class="brand__logo-img brand__logo-img--dark"
          src={withBase("/brand/slop-university-gold-white.svg")}
          alt="Slop University"
          width="278"
          height="43"
        />
      </a>
      <a class="brand__home" href={withBase("/")}>← SLOP3841 course home</a>
      <div class="brand__sub">{siteConfig.licence}</div>
    </div>
    <button class="mobile-bar" id="railToggle" type="button" aria-expanded="false" aria-controls="rail">
      Menu
    </button>
  </div>

  <button
    class="theme-toggle"
    id="themeToggle"
    type="button"
    aria-pressed="false"
    aria-label="Switch to dark theme"
  >
    <span class="theme-toggle__icon" aria-hidden="true" data-theme-icon>◐</span>
    <span data-theme-label>Dark mode</span>
  </button>

  <nav class="rail-nav" aria-label="Course">
    <p class="rail-nav__label" aria-hidden="true">Navigate</p>
    {
      links.map((link) => (
        <a href={withBase(link.href)} aria-current={isCurrent(link.href) ? "page" : undefined}>
          {link.text}
        </a>
      ))
    }
  </nav>

  <div class="tracker" aria-label="Semester progress">
    <div class="tracker__label">
      <span>Audit tracker</span>
      <span>{trackerLabel}</span>
    </div>
    <progress class="tracker__bar" value={taught} max={weeks.length}></progress>
    <div class="tracker__grid">
      {
        weeks.map((w) => (
          <a
            class="tick"
            data-state={w.state}
            data-selected={selectedWeek?.week === w.week ? "true" : undefined}
            href={w.href}
            title={w.title}
            aria-current={selectedWeek?.week === w.week ? "true" : undefined}
          >
            {String(w.week).padStart(2, "0")}
          </a>
        ))
      }
    </div>
  </div>

  <div class="rail-foot">
    {siteConfig.licence}
  </div>
</aside>

<script is:inline data-astro-rerun>
  (function () {
    var STORAGE_KEY = "slop3841-theme";
    var toggle = document.getElementById("themeToggle");
    var railToggle = document.getElementById("railToggle");
    var rail = document.getElementById("rail");

    function currentTheme() {
      return document.documentElement.dataset.theme === "dark" ||
        (!document.documentElement.dataset.theme &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
        ? "dark"
        : "light";
    }

    function paint(theme) {
      var label = toggle.querySelector("[data-theme-label]");
      var icon = toggle.querySelector("[data-theme-icon]");
      var goingTo = theme === "dark" ? "light" : "dark";
      toggle.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
      toggle.setAttribute("aria-label", "Switch to " + goingTo + " theme");
      if (label) label.textContent = goingTo === "dark" ? "Dark mode" : "Light mode";
      if (icon) icon.textContent = theme === "dark" ? "◑" : "◐";
    }

    if (toggle) {
      paint(currentTheme());
      toggle.addEventListener("click", function () {
        var next = currentTheme() === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch (e) {
          /* storage unavailable — theme still applies for this load */
        }
        paint(next);
      });
    }

    if (railToggle && rail) {
      railToggle.addEventListener("click", function () {
        var open = rail.classList.toggle("is-open");
        railToggle.setAttribute("aria-expanded", open ? "true" : "false");
        railToggle.textContent = open ? "Close" : "Menu";
      });
    }
  })();
</script>
